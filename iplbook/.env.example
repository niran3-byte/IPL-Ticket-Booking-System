# Server-only secrets. Never import these from React.
PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
UPSTASH_REDIS_REST_URL=https://<region>.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
REDIS_URL=rediss://:<token>@<host>:<port>
JWT_SECRET=replace-with-a-long-random-secret
QR_SIGNING_SECRET=replace-with-a-separate-random-secret
PAYMENT_PROVIDER=stripe
PAYMENT_SECRET_KEY=sk_test_replace_me
PAYMENT_WEBHOOK_SECRET=whsec_replace_me
VITE_API_BASE_URL=
